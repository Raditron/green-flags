# Expo inlines any EXPO_PUBLIC_-prefixed variable into the JS bundle at build time — the RN
# equivalent of Vite's VITE_-prefixed vars in frontend/.env.example. Copy this file to `.env` and
# fill in the same values already used by ../frontend/.env (same backend, same Firebase project —
# see issue #91's Implementation Decisions).

EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
